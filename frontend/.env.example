# URL base da API backend.
# - Em desenvolvimento local: deixe vazio/comentado, o proxy do Vite (vite.config.js) redireciona /api para localhost.
# - Em produção (Vercel): aponte para a URL pública do backend no Render.
#   Exemplo: VITE_API_URL=https://dotchflow-api.onrender.com/api
VITE_API_URL=

# Porta do backend local, usada só pelo proxy do Vite em desenvolvimento
# (vite.config.js). Deve bater com o PORT configurado no backend/.env.
# Sem produção nenhum efeito - lá o VITE_API_URL acima é usado direto.
VITE_BACKEND_PORT=3001
