# Used by docker-compose.yml for the local Docker/Podman deploy.
# Copy to .env: cp .env.example .env

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional - defaults to "dotchflow_local" if unset. Only matters for the
# local Postgres container, not Neon.
POSTGRES_PASSWORD=dotchflow_local
