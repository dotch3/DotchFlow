PORT=3001
JWT_SECRET=change_this_to_a_long_random_string
MAX_USERS=50
CLEANUP_INTERVAL_DAYS=30

# Postgres connection string (Neon). Get it from the Neon dashboard:
# Project -> Connect -> "Pooled connection" -> copy the postgresql:// URL.
# It already includes ?sslmode=require, which this app expects.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Set to false only if connecting to a local/self-hosted Postgres without SSL.
# DATABASE_SSL=false
